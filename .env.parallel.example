STACK_NAME=nestjs-prisma-kafka
PORT=3005
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger_kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=ledger.transfers.kafka
# Deliberate 5s consumer delay so the queue can accumulate Ready messages.
PROCESS_DELAY_MS=5000
# Max unacked messages per consumer (default 5).
PREFETCH=5
