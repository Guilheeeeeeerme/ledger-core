STACK_NAME=nestjs-prisma-bullmq
PORT=3003
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger_bullmq
REDIS_URL=redis://localhost:6379
QUEUE_NAME=ledger.bullmq
BULLMQ_QUEUE=ledger.bullmq
# Deliberate 5s consumer delay so the queue can accumulate Ready messages.
PROCESS_DELAY_MS=5000
# Max unacked messages per consumer (default 5).
PREFETCH=5
