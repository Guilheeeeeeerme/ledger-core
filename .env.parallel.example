STACK_NAME=raw
PORT=3000
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger_raw
RABBITMQ_URL=amqp://ledger:ledger@localhost:5672
QUEUE_NAME=ledger.transfers.raw
# Deliberate 5s consumer delay so the queue can accumulate Ready messages.
PROCESS_DELAY_MS=5000
# Max unacked messages per consumer (default 5).
PREFETCH=5
