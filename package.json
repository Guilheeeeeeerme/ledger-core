{
  "name": "ledger-core",
  "version": "1.0.0",
  "private": true,
  "description": "Double-entry ledger MVP with a NestJS HTTP API, Prisma, PostgreSQL, Redis, BullMQ, and a React tester",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guilheeeeeeerme/ledger-core.git"
  },
  "homepage": "https://github.com/Guilheeeeeeerme/ledger-core#readme",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "build:web": "npm --prefix web ci && npm --prefix web run build",
    "test": "npm run build:web && DATABASE_URL=${DATABASE_URL:-postgres://ledger:ledger@localhost:5432/ledger} prisma generate && node --import tsx --test test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.16.2",
    "bullmq": "^5.61.0",
    "express": "^5.1.0",
    "ioredis": "^5.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
